{
  "name": "@boxsh/sandbox",
  "version": "0.2.0",
  "description": "Run shell commands against an isolated virtual filesystem, in the browser or Node. 70+ coreutils compiled to WebAssembly; no host shell, no host filesystem.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine/*.wasm": "./engine/*.wasm"
  },
  "files": [
    "dist",
    "src",
    "engine",
    "docs",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "sandbox",
    "shell",
    "bash",
    "coreutils",
    "wasm",
    "webassembly",
    "virtual-filesystem",
    "agents",
    "browser"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:engine": "node scripts/build-engine.mjs",
    "prepack": "npm run build && node scripts/sync-docs.mjs && node scripts/check-engine.mjs",
    "test": "node test/smoke.mjs && node test/api.mjs && node test/idb.mjs",
    "test:bundled": "node test/bundled.mjs",
    "test:browser": "playwright test --config test/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0"
  }
}
